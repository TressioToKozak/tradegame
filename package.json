{
  "name": "jw-collection-store",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:images:strict && tsc -b && vite build",
    "test": "vitest run src",
    "preview": "vite preview --host 0.0.0.0",
    "check:images": "node scripts/check-images.mjs",
    "check:images:strict": "node scripts/check-images.mjs --strict",
    "test:e2e": "playwright test",
    "check:images:all": "node scripts/check-images.mjs --all",
    "report:images": "node scripts/report-media.mjs"
  },
  "dependencies": {
    "dexie": "^4.0.11",
    "lucide-react": "^0.468.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}
